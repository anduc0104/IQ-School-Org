{
  "name": "iq-diagram",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "seed": "node server/seed.js",
    "seed:force": "node server/seed.js --force",
    "import:source": "node scripts/run-import.mjs",
    "build": "npm --prefix client run build"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
